#include <stdio.h>
#include <stdarg.h>
#include <string.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/queue.h"
#include "driver/gpio.h"
#include "esp_timer.h"
#include "esp_lcd_panel_io.h"
#include "esp_lcd_panel_vendor.h"
#include "esp_lcd_panel_ops.h"
#include "esp_heap_caps.h"
#include "esp_log.h"
#include "lvgl.h"

static const char *TAG = "EPROO_LVGL";
// Распиновка LilyGo T-Display-S3 (i8080 8-bit)
#define LCD_PIN_POWER   15
#define LCD_PIN_BL      38
#define LCD_PIN_RD      9
#define LCD_PIN_WR      8
#define LCD_PIN_RS      7
#define LCD_PIN_CS      6
#define LCD_PIN_RST     5

#define LCD_PIN_D0      39
#define LCD_PIN_D1      40
#define LCD_PIN_D2      41
#define LCD_PIN_D3      42
#define LCD_PIN_D4      45
#define LCD_PIN_D5      46
#define LCD_PIN_D6      47
#define LCD_PIN_D7      48
#define BTN_CLEAR_PIN   GPIO_NUM_14   // Нижняя кнопка (KEY) на LilyGo T-Display-S3
#define LCD_H_RES       320
#define LCD_V_RES       170
// Настройки текстовой консоли
#define LOG_QUEUE_LEN       16      // Глубина очереди сообщений
#define LOG_LINE_MAX_LEN    48      // Макс. длина одной строки (с учетом '\0')
#define LOG_MAX_LINES       10      // Кол-во строк на экране (под высоту 170px)

static esp_lcd_panel_handle_t panel_handle = NULL;
static QueueHandle_t log_queue = NULL;
static lv_obj_t *console_label = NULL;
// Кольцевой буфер строк и общий буфер для отрисовки в lv_label
static char log_lines_arr[LOG_MAX_LINES][LOG_LINE_MAX_LEN];
static int screen_log_line_count = 0;
static char screen_log_text_buf[LOG_MAX_LINES * LOG_LINE_MAX_LEN];

// Потокобезопасная неблокирующая функция логирования на экран
void send_msg_to_log_queue(const char *fmt, ...)
{
    if (log_queue == NULL) {
        return;
    }
    char msg[LOG_LINE_MAX_LEN];
    va_list args;
    va_start(args, fmt);
    vsnprintf(msg, sizeof(msg), fmt, args);
    va_end(args);
    // Убираем завершающий '\n', если пользователь передал его в строке
    size_t len = strlen(msg);
    if (len > 0 && msg[len - 1] == '\n') {
        msg[len - 1] = '\0';
    }
    // Кладем в очередь без блокировки (таймаут = 0)
    xQueueSend(log_queue, msg, 0);
}


static void add_log_line(const char *line)
{
    if (screen_log_line_count < LOG_MAX_LINES) {
        strcpy(log_lines_arr[screen_log_line_count], line);
        screen_log_line_count++;
    } else {
        memmove(log_lines_arr, *(log_lines_arr + 1), (LOG_MAX_LINES - 1) * LOG_LINE_MAX_LEN);
        strcpy(log_lines_arr[LOG_MAX_LINES - 1], line);
    }
}

static void fill_text_set_label_text_n_lv_refresh(void)
{
    if (console_label == NULL) return;
    *screen_log_text_buf = '\0';
    for (int i = 0; i < screen_log_line_count; i++) {
        strcat(screen_log_text_buf, log_lines_arr[i]);
        if (i < screen_log_line_count - 1) {
            strcat(screen_log_text_buf, "\n");
        }
    }
    lv_label_set_text(console_label, screen_log_text_buf);
    lv_refr_now(NULL); // Мгновенная отрисовка без ожидания таймеров LVGL
}



// Колбэк завершения передачи DMA -> сообщаем LVGL, что буфер свободен
static bool on_color_trans_done(esp_lcd_panel_io_handle_t panel_io, esp_lcd_panel_io_event_data_t *edata, void *user_ctx)
{
    lv_display_t *disp = (lv_display_t *)user_ctx;
	//printf(".");  //ISR -unsafe!!!
    lv_display_flush_ready(disp);
    return false;
}

// Колбэк отрисовки области экрана из LVGL в контроллер ST7789
static void lvgl_flush_cb(lv_display_t *disp, const lv_area_t *area, uint8_t *px_map)
{
    uint32_t len = lv_area_get_size(area);
    lv_draw_sw_rgb565_swap(px_map, len);
	//printf(".");fflush(stdout);
	printf("[%lld] .\n", esp_timer_get_time() / 1000);
    esp_lcd_panel_draw_bitmap(panel_handle, area->x1, area->y1, area->x2 + 1, area->y2 + 1, px_map);
}

// Системный тик LVGL (каждые 2 мс) -  больше не нужная функция??
//static void lvgl_tick_cb(void *arg){    lv_tick_inc(2);}

//  и этот тоже не нужен?
static uint32_t esp_lv_tick_get_cb_return_time(void)
{
    return (uint32_t)(esp_timer_get_time() / 1000ULL);
}


// Тестовая задача №1 (запустим на Core 0)
static void worker_task_core0(void *pvParameters)
{
    uint32_t counter = 0;
    while (1) {
        send_msg_to_log_queue("+[Core %d] tASK counter #%lu ok", xPortGetCoreID(), counter++);
        vTaskDelay(pdMS_TO_TICKS(1300));
    }
}

// Тестовая задача №2 (запустим на Core 1)
static void worker_task_core1(void *pvParameters)
{
    uint32_t step = 100;
    while (1) {
        size_t free_heap = esp_get_free_heap_size() / 1024;
        send_msg_to_log_queue("+[Core %d] steP %lu Heap%uKB", xPortGetCoreID(), step, free_heap);
        step += 1;
        vTaskDelay(pdMS_TO_TICKS(2100));
    }
}


static void print_memory_info(void)
{
    printf("\n================ ESP32-S3 MEMORY INFO ================\n");
    printf("Internal RAM free:     %6u KB (min: %u KB)\n",
           heap_caps_get_free_size(MALLOC_CAP_INTERNAL) / 1024,
           heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL) / 1024);

    printf("Internal DMA free:     %6u KB (largest block: %u KB)\n",
           heap_caps_get_free_size(MALLOC_CAP_DMA) / 1024,
           heap_caps_get_largest_free_block(MALLOC_CAP_DMA) / 1024);

    size_t psram_total = heap_caps_get_total_size(MALLOC_CAP_SPIRAM);
    if (psram_total > 0) {
        printf("External PSRAM free:   %6u KB / %u KB\n",
               heap_caps_get_free_size(MALLOC_CAP_SPIRAM) / 1024,
               psram_total / 1024);
    } else {
        printf("External PSRAM:        Not enabled / Not detected\n");
    }
    printf("======================================================\n\n");
}


// Вывод списка всех задач FreeRTOS в стандартный терминал (idf.py monitor)
static void print_tasks_to_serial(void)
{
#if (configUSE_TRACE_FACILITY == 1)
    UBaseType_t task_count = uxTaskGetNumberOfTasks();
    TaskStatus_t *status_array = malloc(task_count * sizeof(TaskStatus_t));
    if (status_array == NULL) {
        ESP_LOGE(TAG, "Не хватило памяти для списка задач");
        return;
    }
    task_count = uxTaskGetSystemState(status_array, task_count, NULL);
    printf("\n====1602====== FREERTOS TASKS (%u) ===========\n", (unsigned int)task_count);
    printf("%-16s | %-4s | %-7s | %-4s | %-8s\n", "Name", "Core", "State", "Prio", "MinStack");
    printf("-----------------------------------------------------\n");
    for (UBaseType_t i = 0; i < task_count; i++) {
        const char *state_str = "Unknown";
        switch (status_array[i].eCurrentState) {
            case eRunning:   state_str = "Running"; break;
            case eReady:     state_str = "Ready";   break;
            case eBlocked:   state_str = "Blocked"; break;
            case eSuspended: state_str = "Suspend"; break;
            case eDeleted:   state_str = "Deleted"; break;
            default:         break;
        }
        char core_str[5] = "Any";
        BaseType_t core_id = xTaskGetCoreID(status_array[i].xHandle);
        if (core_id == 0) {
            strcpy(core_str, "0");
        } else if (core_id == 1) {
            strcpy(core_str, "1");
        }

        printf("%-16s | %-4s | %-7s | %-4u | %-8u\n",
               status_array[i].pcTaskName,
               core_str,
               state_str,
               (unsigned int)status_array[i].uxCurrentPriority,
               (unsigned int)status_array[i].usStackHighWaterMark);
    }
    printf("=====================================================\n\n");
    free(status_array);
#else
    ESP_LOGW(TAG, "Включите CONFIG_FREERTOS_USE_TRACE_FACILITY в menuconfig");
#endif
}


static void IRAM_ATTR clear_btn_isr_handler(void *arg)
{
    char cmd[LOG_LINE_MAX_LEN] = "\x01CLEAR";
    BaseType_t xHigherPriorityTaskWoken = pdFALSE;
    xQueueSendFromISR(log_queue, cmd, &xHigherPriorityTaskWoken);
    if (xHigherPriorityTaskWoken) {
        portYIELD_FROM_ISR();
    }
}



static void init_clear_button(void)
{
    gpio_config_t btn_conf = {
        .pin_bit_mask = (1ULL << BTN_CLEAR_PIN),
        .mode = GPIO_MODE_INPUT,
        .pull_up_en = GPIO_PULLUP_ENABLE,
        .pull_down_en = GPIO_PULLDOWN_DISABLE,
        .intr_type = GPIO_INTR_NEGEDGE
    };
    gpio_config(&btn_conf);
    gpio_install_isr_service(0);
    gpio_isr_handler_add(BTN_CLEAR_PIN, clear_btn_isr_handler, NULL);
}


void app_main(void)
{
    print_memory_info();
    // Создаем очередь до запуска задач, чтобы не потерять первые логи
    log_queue = xQueueCreate(LOG_QUEUE_LEN, LOG_LINE_MAX_LEN);
    assert(log_queue != NULL);

    ESP_LOGI(TAG, "1. Включаем питание дисплея и подсветку...");
    gpio_config_t io_conf = {
        .mode = GPIO_MODE_OUTPUT,
        .pin_bit_mask = (1ULL << LCD_PIN_POWER) | (1ULL << LCD_PIN_BL) | (1ULL << LCD_PIN_RD),
    };
    gpio_config(&io_conf);
    gpio_set_level(LCD_PIN_POWER, 1);
    gpio_set_level(LCD_PIN_RD, 1);
    gpio_set_level(LCD_PIN_BL, 1);

    ESP_LOGI(TAG, "2. Инициализируем шину i8080 и контроллер ST7789...");
    esp_lcd_i80_bus_handle_t i80_bus = NULL;
    esp_lcd_i80_bus_config_t bus_config = {
        .clk_src = LCD_CLK_SRC_DEFAULT,
        .dc_gpio_num = LCD_PIN_RS,
        .wr_gpio_num = LCD_PIN_WR,
        .data_gpio_nums = {
            LCD_PIN_D0, LCD_PIN_D1, LCD_PIN_D2, LCD_PIN_D3,
            LCD_PIN_D4, LCD_PIN_D5, LCD_PIN_D6, LCD_PIN_D7,
        },
        .bus_width = 8,
        .max_transfer_bytes = LCD_H_RES * LCD_V_RES * sizeof(uint16_t),

    };
    ESP_ERROR_CHECK(esp_lcd_new_i80_bus(&bus_config, &i80_bus));

    esp_lcd_panel_io_handle_t io_handle = NULL;
    esp_lcd_panel_io_i80_config_t io_config = {
        .cs_gpio_num = LCD_PIN_CS,
        .pclk_hz = 10 * 1000 * 1000,
        .trans_queue_depth = 10,
        .dc_levels = {
            .dc_idle_level = 0,
            .dc_cmd_level = 0,
            .dc_dummy_level = 0,
            .dc_data_level = 1,
        },
        .lcd_cmd_bits = 8,
        .lcd_param_bits = 8,
    };
    ESP_ERROR_CHECK(esp_lcd_new_panel_io_i80(i80_bus, &io_config, &io_handle));

    esp_lcd_panel_dev_config_t panel_config = {
        .reset_gpio_num = LCD_PIN_RST,
        .rgb_ele_order = LCD_RGB_ELEMENT_ORDER_RGB,
        .bits_per_pixel = 16,
    };
    ESP_ERROR_CHECK(esp_lcd_new_panel_st7789(io_handle, &panel_config, &panel_handle));
    ESP_ERROR_CHECK(esp_lcd_panel_reset(panel_handle));
    ESP_ERROR_CHECK(esp_lcd_panel_init(panel_handle));

    // Настройка ориентации и смещения для матрицы 170x320
    ESP_ERROR_CHECK(esp_lcd_panel_invert_color(panel_handle, true));
    ESP_ERROR_CHECK(esp_lcd_panel_swap_xy(panel_handle, true));
    ESP_ERROR_CHECK(esp_lcd_panel_mirror(panel_handle, false, true));
    ESP_ERROR_CHECK(esp_lcd_panel_set_gap(panel_handle, 0, 35));
    ESP_ERROR_CHECK(esp_lcd_panel_disp_on_off(panel_handle, true));

    ESP_LOGI(TAG, "3. Инициализируем LVGL 9...");
    lv_init();
    //регистрируем коллбэк функцию которая возвращает текущее время?
    lv_tick_set_cb(esp_lv_tick_get_cb_return_time);

    lv_display_t *disp = lv_display_create(LCD_H_RES, LCD_V_RES);
    lv_display_set_flush_cb(disp, lvgl_flush_cb);

    const esp_lcd_panel_io_callbacks_t cbs = {
        .on_color_trans_done = on_color_trans_done,
    };
    ESP_ERROR_CHECK(esp_lcd_panel_io_register_event_callbacks(io_handle, &cbs, disp));

    // Выделяем только ОДИН полноэкранный буфер в DMA-памяти
    size_t buf_size = LCD_H_RES * LCD_V_RES * sizeof(uint16_t);
    void *buf1 = heap_caps_malloc(buf_size, MALLOC_CAP_DMA);
    assert(buf1);
    lv_display_set_buffers(disp, buf1, NULL, buf_size, LV_DISPLAY_RENDER_MODE_PARTIAL);

    // да и таймер тиков LVGL (2 мс) тоже больше нужен, мы работаем с queue!
    //const esp_timer_create_args_t tick_timer_args = {
    //    .callback = &lvgl_tick_cb,
    //    .name = "lvgl_tick"
    //};
    //esp_timer_handle_t tick_timer = NULL;
    //ESP_ERROR_CHECK(esp_timer_create(&tick_timer_args, &tick_timer));
    //ESP_ERROR_CHECK(esp_timer_start_periodic(tick_timer, 2000));
    ESP_LOGI(TAG, "4. Настраиваем виджет консоли (одиночный Label)...");
    lv_obj_t *scr = lv_screen_active();

    console_label = lv_label_create(scr);
    lv_obj_set_width(console_label, LCD_H_RES - 10); // Небольшой отступ по бокам
    lv_label_set_long_mode(console_label, LV_LABEL_LONG_MODE_WRAP);
    lv_obj_set_style_text_color(console_label, lv_color_hex(0x00FF66), LV_PART_MAIN);
    lv_obj_set_style_text_align(console_label, LV_TEXT_ALIGN_LEFT, 0);
    lv_obj_align(console_label, LV_ALIGN_TOP_LEFT, 5, 4);
    //  Задаем ярко-зеленый (терминальный) цвет текста для label
    //lv_obj_set_style_text_color(console_label, lv_color_hex(0x00FF00), 0);
    // Делаем фон самого экрана черным и непрозрачным
    lv_obj_set_style_bg_color(lv_screen_active(), lv_color_hex(0x000000), 0);
    lv_obj_set_style_bg_opa(lv_screen_active(), LV_OPA_COVER, 0);
    lv_label_set_text(console_label, "all prePared....");
    send_msg_to_log_queue(" lbgl on Core %d log qu...", xPortGetCoreID());

    init_clear_button();

    // Запускаем две тестовые задачи на разных ядрах ESP32-S3
    xTaskCreatePinnedToCore(worker_task_core0, "task_c0", 3072, NULL, 5, NULL, 0);
    xTaskCreatePinnedToCore(worker_task_core1, "task_c1", 3072, NULL, 5, NULL, 1);
	int64_t last_tasks_dump_us = esp_timer_get_time();
    while (1) {
        char incoming[LOG_LINE_MAX_LEN];
        // Задача СПИТ (0% CPU), пока не придет лог, нажатие кнопки или не пройдет 8 сек
        if (xQueueReceive(log_queue, incoming, pdMS_TO_TICKS(8000)) == pdTRUE) {
          do {
             if (*incoming == '\x01') {
                // Команда очистки от кнопки GPIO 14
                xQueueReset(log_queue);
                screen_log_line_count = 1;
                snprintf(*log_lines_arr, LOG_LINE_MAX_LEN, "buffer cleared by GPIO %d", BTN_CLEAR_PIN);
                } else {
                // Обычная строка лога (ваш существующий сдвиг log_lines_arr)
                add_log_line(incoming);
               }
          } while (xQueueReceive(log_queue, incoming, 0) == pdTRUE);

            // Собираем screen_log_text_buf, обновляем Label и мгновенно рисуем кадр
            fill_text_set_label_text_n_lv_refresh(); // внутри lv_label_set_text + lv_refr_now(NULL)
        }
        //uint32_t delay_ms = lv_timer_handler(); LVGL перерисовывает измененную область
        // Печать таблицы задач раз в 8 секунд
        int64_t now_us = esp_timer_get_time();
        if (now_us - last_tasks_dump_us >= 8000000LL) {
         last_tasks_dump_us = now_us;
           print_tasks_to_serial();
        }

    }
}

